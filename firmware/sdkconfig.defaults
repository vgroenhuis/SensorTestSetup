CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# A new image must prove itself (report to the server) or the bootloader goes back to the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_HTTPD_WS_SUPPORT=y
# No Bluetooth: Wi-Fi has the radio to itself (closer_ble then does nothing).
CONFIG_BT_ENABLED=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# closer_udp: two UDP sockets next to the web server, heartbeats and updates
CONFIG_LWIP_MAX_SOCKETS=16

# 4 MB PSRAM on the N16R4 module: big allocations (TLS buffers) go there, internal RAM stays free for Wi-Fi.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# Software AES for TLS: the hardware AES's DMA bounce buffers ran out of internal RAM during firmware downloads (BesBot 1.7.2)
# CONFIG_MBEDTLS_HARDWARE_AES is not set
