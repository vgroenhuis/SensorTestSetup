	(text "8 solenoids, 12 V (V_BUS: 9-12.6 V on the pack),\nup to 500 mA each. Row n: pin 2n+1 V_SOL, pin\n2n+2 SOLn (switched to GND). MCP23008 0x21\nGP0-7: high = on; off at reset (pull-downs).\nPolyfuse 2 A hold, 3.5 A trip: four at 500 mA\nhold; all eight trip it after a while."
		(exclude_from_sim no)
		(at 457.2 55.88 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "31074394-0e98-5da9-b99a-18cbee0e6385")
	)
